# Hafnium's own packages (hafnium, hafnium-dots), built by GitHub Actions and
# served from GitHub Pages: https://github.com/euandeas/hafnium
[hafnium]
name=Hafnium
baseurl=https://euandeas.github.io/hafnium/repo/
type=rpm-md
skip_if_unavailable=True
# Unsigned packages, fetched over HTTPS from your own GitHub Pages site.
gpgcheck=0
repo_gpgcheck=0
enabled=1
metadata_expire=6h

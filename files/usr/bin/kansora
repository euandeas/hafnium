#!/usr/bin/bash
# kansora: Kansora's helper command. Recipes live in /usr/share/kansora/just/00-start.just.
#   kansora              overview
#   kansora help         all commands
#   kansora choose       pick a command interactively
#   kansora <command>    run a command
set -uo pipefail

JUSTFILE=/usr/share/kansora/just/00-start.just
recipes() { just --justfile "$JUSTFILE" --working-directory "$HOME" "$@"; }

bold=$'\e[1m' dim=$'\e[2m' reset=$'\e[0m'
[[ -t 1 && -z "${NO_COLOR:-}" ]] || bold="" dim="" reset=""

build() { # "0.1.0, build 10 (7acb279)" from 0.1.0-10.git7acb279.fc45
    local v r
    v="$(rpm -q --qf '%{VERSION}' "$1" 2>/dev/null)" || { echo "not installed"; return; }
    r="$(rpm -q --qf '%{RELEASE}' "$1")"
    r="${r%.fc*}"
    if [[ "$r" == *.git* ]]; then echo "$v, build ${r%%.git*} (${r#*.git})"; else echo "$v-$r"; fi
}

overview() {
    local variant="AMD / Intel"
    rpm -q kansora-nvidia >/dev/null 2>&1 && variant="NVIDIA"
    cat <<EOF
${bold}Kansora${reset} ${dim}·${reset} Fedora $(rpm -E %fedora) ${dim}·${reset} ${variant}
  kansora       $(build kansora)
  kansora-dots  $(build kansora-dots)

${bold}Common commands${reset}
  kansora update            update everything: dnf, flatpaks, firmware
  kansora sync-greeter      copy your DMS look to the login screen
  kansora upgrade-fedora    move to the next Fedora release
  kansora dotfiles-status   show which dotfiles are applied

Run ${bold}kansora help${reset} for every command.
EOF
}

help() {
    cat <<EOF
${bold}Usage${reset}: kansora <command> [arguments]

${bold}Commands${reset}
EOF
    recipes --list --unsorted --list-heading '' --list-prefix '  '
    cat <<EOF
  choose                    # pick a command interactively
  help                      # show this help

Docs: https://github.com/euandeas/kansora
EOF
}

case "${1:-}" in
    "") overview ;;
    help | -h | --help) help ;;
    choose) recipes --choose ;;
    *) exec just --justfile "$JUSTFILE" --working-directory "$HOME" "$@" ;;
esac

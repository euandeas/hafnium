#!/usr/bin/env bash
# Install everything build-scripts/check needs, inside a fresh Fedora container (CI).
#   build-scripts/ci-setup
set -euo pipefail
here="$(dirname "$(readlink -f "$0")")"

# Terra (mise) and the Dux COPRs (dms-cli, for generating DMS defaults)
dnf install -y --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release
cp "$here"/../repos/_copr*.repo /etc/yum.repos.d/

dnf install -y --setopt=install_weak_deps=False \
    git-core make rpm-build systemd-rpm-macros createrepo_c rpmlint sudo \
    pykickstart ShellCheck just jq python3 \
    niri mise dms-cli ghostty

git config --global --add safe.directory '*'

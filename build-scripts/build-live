#!/usr/bin/env bash
# Build the Kansora live ISO with kiwi (description: live/kansora.kiwi).
#
#   build-scripts/build-live [output-dir]
#
# Needs root plus kiwi, kiwi-systemdeps and distribution-gpg-keys; CI runs it in
# a privileged Fedora container. Env: FEDORA_VERSION (default 45), and
# KANSORA_REPO: a local repo from build-repo (its repo/ directory) to install
# Kansora's packages from instead of the published one, for testing a branch.
set -euo pipefail

outdir="$(readlink -m "${1:-out}")"
here="$(dirname "$(readlink -f "$0")")"
FEDORA_VERSION="${FEDORA_VERSION:-45}"
work="$outdir/live-build"
name="kansora-live-${FEDORA_VERSION}-x86_64.iso"
limit=$((2 * 1024 * 1024 * 1024))   # GitHub release asset limit

rm -rf "$work"
mkdir -p "$outdir"

desc="$here/../live"
if [[ -n "${KANSORA_REPO:-}" ]]; then
    repo="$(readlink -f "$KANSORA_REPO")"
    [[ -f "$repo/repodata/repomd.xml" ]] || { echo "build-live: $repo is not a dnf repo" >&2; exit 1; }
    desc="$outdir/live-description"
    rm -rf "$desc" && cp -a "$here/../live" "$desc"
    sed -i "s|<source path=\"https://euandeas.github.io/kansora/repo/\"/>|<source path=\"dir://$repo\"/>|" "$desc/kansora.kiwi"
    grep -qF "dir://$repo" "$desc/kansora.kiwi" \
        || { echo "build-live: couldn't point live/kansora.kiwi at $repo" >&2; exit 1; }
    echo "build-live: installing Kansora's packages from $repo"
fi
kiwi-ng --type iso system build --description "$desc" --target-dir "$work"

iso="$(find "$work" -maxdepth 1 -name '*.iso' | head -n1)"
[[ -n "$iso" ]] || { echo "build-live: kiwi produced no ISO" >&2; exit 1; }
mv "$iso" "$outdir/$name"
(cd "$outdir" && sha256sum "$name" > "$name.sha256")
rm -rf "$work" "$outdir/live-description"

size="$(stat -c %s "$outdir/$name")"
printf 'built %s: %d MiB\n' "$outdir/$name" "$((size / 1024 / 1024))"
if ((size >= limit)); then
    echo "build-live: ISO is over 2 GiB, too big for a GitHub release" >&2
    exit 1
fi

#!/usr/bin/python3
"""Draw every Kansora logo asset from the mark's geometry.

The mark is a K in two strokes on a 64-unit grid: a stem from (19,10) to
(19,54), and one quadratic curve for both arms from (47,10) through (13,32)
to (47,54), both 7 wide with round caps. The outputs are filled outlines (no
strokes), so icon themes can recolour the symbolic icon.

Writes SVGs and PNGs into branding/ and files/; the results are committed, so
building the RPM needs nothing extra. Rerun after changing the mark:

    build-scripts/render-branding        (needs ImageMagick: magick)
"""
import math
import os
import subprocess
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Flexoki
BLUE_600 = "#205EA6"
BLUE_400 = "#4385BE"
PAPER = "#FFFCF0"
BASE_200 = "#CECDC3"   # Flexoki tx (dark)
BASE_700 = "#575653"
SYMBOLIC = "#2e3436"   # the colour GTK recolours in -symbolic icons

STROKE = 7.0


def k_path():
    """The K as one filled path (stem plus curve, each with round caps)."""
    r = STROKE / 2
    stem = (f"M{19 - r} 10 V54 A{r} {r} 0 0 0 {19 + r} 54 V10 "
            f"A{r} {r} 0 0 0 {19 - r} 10 Z")

    p0, p1, p2 = (47, 10), (13, 32), (47, 54)
    n = 96
    left, right = [], []
    for i in range(n + 1):
        t = i / n
        x = (1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * p1[0] + t ** 2 * p2[0]
        y = (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * p1[1] + t ** 2 * p2[1]
        dx = 2 * (1 - t) * (p1[0] - p0[0]) + 2 * t * (p2[0] - p1[0])
        dy = 2 * (1 - t) * (p1[1] - p0[1]) + 2 * t * (p2[1] - p1[1])
        length = math.hypot(dx, dy)
        nx, ny = -dy / length * r, dx / length * r
        left.append((x + nx, y + ny))
        right.append((x - nx, y - ny))

    def pt(p):
        return f"{p[0]:.3f} {p[1]:.3f}"

    curve = "M" + pt(left[0]) + "".join(" L" + pt(p) for p in left[1:])
    curve += f" A{r} {r} 0 0 0 " + pt(right[-1])
    curve += "".join(" L" + pt(p) for p in reversed(right[:-1]))
    curve += f" A{r} {r} 0 0 0 " + pt(left[0]) + " Z"
    return stem + " " + curve


K = k_path()
# The K's bounding box is x 15.5-50.5, y 6.5-57.5: centre (33, 32)
CENTRE = "translate(-33 -32)"


def svg(body, size=64):
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{size}" height="{size}" '
            f'viewBox="0 0 {size} {size}">{body}</svg>\n')


def mark(colour):
    return svg(f'<path d="{K}" fill="{colour}"/>')


def app_icon():
    return svg(f'<rect x="4" y="4" width="56" height="56" rx="14" fill="{BLUE_600}"/>'
               f'<path d="{K}" fill="{PAPER}" transform="translate(32 32) scale(.6) {CENTRE}"/>')


def symbolic():
    return svg(f'<path d="{K}" fill="{SYMBOLIC}" transform="translate(8 8) scale(.25) {CENTRE}"/>', 16)


def write(path, text):
    path = os.path.join(ROOT, path)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)
    return path


def png(svg_text, out, width, height=None):
    out = os.path.join(ROOT, out)
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with tempfile.NamedTemporaryFile("w", suffix=".svg") as f:
        f.write(svg_text)
        f.flush()
        subprocess.run(["magick", "-background", "none", "-density", "1200", f.name,
                        "-resize", f"{width}x{height or width}", "-strip",
                        f"PNG32:{out}"], check=True)


def throbber_frame(i, frames):
    """Three dots, a highlight passing left to right."""
    def mix(a, b, t):
        a = [int(a[k:k + 2], 16) for k in (1, 3, 5)]
        b = [int(b[k:k + 2], 16) for k in (1, 3, 5)]
        return "#" + "".join(f"{round(x + (y - x) * t):02x}" for x, y in zip(a, b))
    dots = ""
    for d, cx in enumerate((8, 32, 56)):
        phase = (i / frames - d / 6) % 1
        glow = max(0.0, math.cos(2 * math.pi * phase)) ** 2
        dots += f'<circle cx="{cx}" cy="8" r="5" fill="{mix(BASE_700, BASE_200, glow)}"/>'
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="64" height="16" '
            f'viewBox="0 0 64 16">{dots}</svg>')


def main():
    # README and anything outside the OS
    write("branding/kansora.svg", mark(BLUE_600))
    write("branding/kansora-dark.svg", mark(BLUE_400))
    write("branding/kansora-app.svg", app_icon())

    # Icon theme: os-release's LOGO=kansora resolves here
    icons = "files/usr/share/icons/hicolor"
    write(f"{icons}/scalable/apps/kansora.svg", app_icon())
    write(f"{icons}/symbolic/apps/kansora-symbolic.svg", symbolic())
    for size in (16, 22, 24, 32, 48, 64, 128, 256, 512):
        png(app_icon(), f"{icons}/{size}x{size}/apps/kansora.png", size)
    write("files/usr/share/pixmaps/kansora.svg", app_icon())

    # Boot splash: the K, with three dots below it as the throbber
    theme = "files/usr/share/plymouth/themes/kansora"
    png(mark(BLUE_400), f"{theme}/watermark.png", 96)
    frames = 30
    for i in range(frames):
        png(throbber_frame(i, frames), f"{theme}/throbber-{i + 1:04d}.png", 64, 16)


if __name__ == "__main__":
    main()

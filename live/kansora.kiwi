<?xml version="1.0" encoding="utf-8"?>
<!--
  Kansora live ISO: boots straight into niri + DMS and installs with Anaconda's
  live installer, which copies this image to disk.
  Modelled on Fedora's own live spins: https://pagure.io/fedora-kiwi-descriptions
  This file is the package set: build-scripts/check dry-runs it nightly. Build: build-scripts/build-live
-->
<image schemaversion="7.4" name="Kansora">
	<description type="system">
		<author>euandeas</author>
		<contact>https://github.com/euandeas/kansora</contact>
		<specification>Kansora live installer: Fedora with niri and DMS</specification>
	</description>
	<preferences>
		<version>45.0.0</version>
		<packagemanager>dnf5</packagemanager>
		<locale>en_US</locale>
		<keytable>us</keytable>
		<timezone>UTC</timezone>
		<release-version>45</release-version>
		<type image="iso"
			publisher="Kansora" volid="Kansora-45-Live" application_id="Kansora"
			primary="true" flags="dmsquash" filesystem="erofs" erofscompression="lzma,level=6" mediacheck="true"
			firmware="uefi" efiparttable="gpt" efifatimagesize="30" kernelcmdline="quiet rhgb"
			fscreateoptions="-Efragments -C 1048576"
			>
			<bootloader name="grub2" grub_template="grub-x86.cfg.iso-template" console="console" timeout="10"/>
		</type>
	</preferences>

	<!-- Fedora, RPM Fusion, Terra, the Dux COPRs and Kansora's own repo -->
	<repository type="rpm-md" alias="fedora" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="updates" sourcetype="metalink">
		<source path="https://mirrors.fedoraproject.org/metalink?repo=updates-released-f$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/fedora/RPM-GPG-KEY-fedora-$releasever-primary"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-free" sourcetype="metalink">
		<source path="https://mirrors.rpmfusion.org/metalink?repo=free-fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-free-updates" sourcetype="metalink">
		<source path="https://mirrors.rpmfusion.org/metalink?repo=free-fedora-updates-released-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-free-fedora-$releasever"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-nonfree" sourcetype="metalink">
		<source path="https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-nonfree-fedora-$releasever"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="rpmfusion-nonfree-updates" sourcetype="metalink">
		<source path="https://mirrors.rpmfusion.org/metalink?repo=nonfree-fedora-updates-released-$releasever&amp;arch=$basearch">
			<signing key="file:///usr/share/distribution-gpg-keys/rpmfusion/RPM-GPG-KEY-rpmfusion-nonfree-fedora-$releasever"/>
		</source>
	</repository>
	<repository type="rpm-md" alias="terra" package_gpgcheck="false" repository_gpgcheck="false">
		<source path="https://repos.fyralabs.com/terra$releasever"/>
	</repository>
	<repository type="rpm-md" alias="duxlabs-dms" package_gpgcheck="false" repository_gpgcheck="false">
		<source path="https://download.copr.fedorainfracloud.org/results/duxlabs/dms/fedora-$releasever-$basearch/"/>
	</repository>
	<repository type="rpm-md" alias="duxlabs-dux-repo" package_gpgcheck="false" repository_gpgcheck="false">
		<source path="https://download.copr.fedorainfracloud.org/results/duxlabs/dux-repo/fedora-$releasever-$basearch/"/>
	</repository>
	<repository type="rpm-md" alias="kansora" package_gpgcheck="false" repository_gpgcheck="false">
		<source path="https://euandeas.github.io/kansora/repo/"/>
	</repository>

	<packages type="bootstrap">
		<package name="fedora-release"/>
		<package name="filesystem"/>
		<package name="grubby"/>
	</packages>

	<!-- The installed system: Fedora Custom OS + NetworkManager submodules + Standard,
	     multimedia, Kansora. Single ISO for every GPU: NVIDIA users run nouveau until
	     `kansora enable-nvidia`, so nvidia-gpu-firmware stays. -->
	<packages type="image" patternType="plusRecommended">
		<namedCollection name="core"/>
		<namedCollection name="networkmanager-submodules"/>
		<namedCollection name="standard"/>
		<namedCollection name="multimedia"/>
		<package name="kansora"/>
		<package name="kernel"/>
		<package name="kernel-core"/>
		<package name="kernel-modules"/>
		<package name="kernel-modules-extra"/>
		<package name="grub2-efi-x64"/>
		<package name="grub2-efi-x64-modules"/>
		<package name="grub2-pc"/>
		<package name="grub2-pc-modules"/>
		<package name="shim-x64"/>
		<package name="efibootmgr"/>
		<package name="btrfs-progs"/>
		<package name="udisks2-btrfs"/>
		<package name="langpacks-en"/>
		<ignore name="kernel-*debug*"/>
		<ignore name="PackageKit-gstreamer-plugin"/>
		<ignore name="ffmpeg-free"/>
		<ignore name="mesa-va-drivers"/>
		<ignore name="alacritty"/>
		<ignore name="fuzzel"/>
		<ignore name="swaylock"/>
		<ignore name="waybar"/>
		<ignore name="sos"/>
		<ignore name="dracut-config-rescue"/>
		<ignore name="sssd*"/>
		<ignore name="PackageKit"/>
		<ignore name="PackageKit-glib"/>
		<ignore name="abrt*"/>
		<ignore name="rsyslog"/>
		<ignore name="setroubleshoot*"/>
		<ignore name="mcelog"/>
		<ignore name="psacct"/>
		<ignore name="plocate"/>
		<ignore name="cyrus-sasl-plain"/>
		<ignore name="iptstate"/>
		<ignore name="pinfo"/>
		<ignore name="systemd-networkd"/>
		<ignore name="tcpdump"/>
		<ignore name="traceroute"/>
		<ignore name="mtr"/>
		<ignore name="at"/>
		<ignore name="bc"/>
		<ignore name="dos2unix"/>
		<ignore name="deltarpm"/>
	</packages>

	<!-- Live session and installer. Anaconda copies the whole image to disk, so
	     these end up on installed systems too (realmd included: the installer
	     requires it, so it can't be excluded above). -->
	<packages type="iso" patternType="plusRecommended">
		<namedCollection name="anaconda-tools"/>
		<package name="anaconda-install-env-deps"/>
		<package name="anaconda-live"/>
		<package name="dracut-live"/>
		<package name="glibc-all-langpacks"/>
		<package name="isomd5sum"/>
		<package name="livesys-scripts"/>
		<package name="kansora-live"/>
		<package name="grub2-efi-x64-cdboot"/>
		<ignore name="device-mapper-multipath"/>
		<ignore name="fcoe-utils"/>
		<ignore name="gfs2-utils"/>
	</packages>

	<users>
		<!-- Locked again in config.sh -->
		<user name="root" groups="root" password="linux" home="/root" pwdformat="plain"/>
	</users>
</image>
